# Copia questo file in .env e adatta i valori alla tua macchina.
# Nessun segreto: sono solo valori locali di sviluppo.

# Database locale di sviluppo (lo crea scripts/avvio-sessione.sh nelle sessioni in cloud)
DATABASE_URL=postgres://mmg:mmg@localhost:5432/mmg_dev

# Fuso orario dello studio
TZ=Europe/Rome

# Porta del servizio applicativo (apps/api) e dell'interfaccia (apps/web)
API_PORT=3001
WEB_PORT=5173

# Integrazioni: sempre simulate (regola 7), nessuna chiamata a servizi reali. Nessuna variabile le
# cambia: i simulatori sono scelti nel codice (apps/api/src/app.ts).

# Chiave per cifrare i segreti a riposo (secondo fattore, credenziali esterne): 32 byte in base64.
# Non va mai nel repository. In cloud la crea scripts/avvio-sessione.sh fuori dal repository;
# in locale: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Durata massima di una sessione in ore (decisione D19)
SESSION_MAX_HOURS=12

# Ambiente dell'installazione (D170): «prova» (per difetto: solo pazienti inventati dove si può
# controllare, dati dimostrativi ammessi) oppure «produzione» (il seed dimostrativo non parte).
APP_AMBIENTE=prova

# Cookie solo su HTTPS: false solo in sviluppo locale
COOKIE_SECURE=false

# Proxy inversi fidati davanti al servizio: indirizzi IP o reti CIDR separati da virgole. Solo da
# questi si legge X-Forwarded-For, per l'indirizzo dei tentativi d'accesso nel registro; vuoto
# (per difetto) = nessun proxy fidato, vale l'indirizzo della connessione. Un valore non valido
# ferma l'avvio.
# APP_PROXY_FIDATI=127.0.0.1

# Aggiornamento delle banche dati dal servizio (D156). Senza BANCHE_DATI_DIR non parte nulla.
# BANCHE_DATI_DIR: cartella dei dati di sync/; BANCHE_DATI_TRASCRIZIONI: trascrizioni dei PDF
# (per difetto quelle del programma, packages/reference/data/trascrizioni, D159);
# BANCHE_DATI_FONTI: «esempio» (sito d'esempio in locale, per le dimostrazioni), «pubbliche»
# (sync/fonti.json, solo in produzione) o un file di fonti; BANCHE_DATI_AGGIORNAMENTO: ora
# dell'aggiornamento di ogni notte (HH:MM, ora dello studio); SYNC_CONTATTO: email nello User-Agent.
# BANCHE_DATI_DIR=/var/lib/mmg/dati-pubblici
# BANCHE_DATI_TRASCRIZIONI=/var/lib/mmg/trascrizioni
# BANCHE_DATI_FONTI=esempio
# BANCHE_DATI_AGGIORNAMENTO=03:30

# AURA, l'anagrafe regionale degli assistiti (D197): ora del controllo di ogni notte di esenzioni
# e scelte del medico. Oggi c'è solo il simulatore; in produzione, con il simulatore, AURA è spenta.
# AURA_AGGIORNAMENTO=02:30

# Codice del gestionale che la Regione Piemonte assegna all'avvio dell'autocertificazione (D267).
# Il programma ci aggiunge «_» e il codice ASL di ogni medico: è il client_id dell'accesso con SPID
# o CIE e l'intestazione X-Gestionale (REL-STC-01 V08). Vuoto vale «SIMULATORE», solo con i simulatori.
# APP_CODICE_GESTIONALE=MIOAPPLICATIVO
