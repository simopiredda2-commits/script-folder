# Copia questo file in .env e adatta i valori alla tua macchina.
# Nessun segreto: sono solo valori locali di sviluppo.

# Database locale di sviluppo (lo crea scripts/avvio-sessione.sh nelle sessioni in cloud)
DATABASE_URL=postgres://mmg:mmg@localhost:5432/mmg_dev

# Fuso orario dello studio
TZ=Europe/Rome

# Porta del servizio applicativo (apps/api) e dell'interfaccia (apps/web)
API_PORT=3001
WEB_PORT=5173

# Integrazioni: sempre simulate in sviluppo. Nessuna chiamata a servizi reali.
INTEGRATIONS_MODE=simulator

# Chiave per cifrare i segreti a riposo (secondo fattore, credenziali esterne): 32 byte in base64.
# Non va mai nel repository. In cloud la crea scripts/avvio-sessione.sh fuori dal repository;
# in locale: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Durata massima di una sessione in ore (decisione D19)
SESSION_MAX_HOURS=12

# Cookie solo su HTTPS: false solo in sviluppo locale
COOKIE_SECURE=false
